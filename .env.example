NODE_ENV=development
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/nestly
# Required in production: at least 32 random characters
SESSION_SECRET=
# Persistent disk directory; never expose this as a static public directory
UPLOAD_DIR=./uploads

# Optional private persistent document directory; default is UPLOAD_DIR/private-authorization
# AUTHORIZATION_DIR=

# Optional monthly rent plausibility bounds in INR (defaults shown)
# MIN_MONTHLY_RENT=2000
# MAX_MONTHLY_RENT=100000

# Production Docker deployment: copy this file to .env.production and configure
# all required fields. Never copy development secrets to production.
APP_ORIGIN=
APP_DOMAIN=
# Optional Google sign-in: see docs/GOOGLE-SIGN-IN.md. Both are required to enable it.
# Register APP_ORIGIN + /auth/google/callback as the Google redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MFA_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=
# Compose supplies separate durable volume paths and the private scanner hostname.
STORAGE_DURABLE=false
CLAMD_HOST=
CLAMD_PORT=3310
SCAN_MAX_AGE_HOURS=72

# Operator-only backup/restore settings (not needed by the web app):
# BACKUP_CONFIRM=
# BACKUP_DIRECTORY=
# MONGO_BACKUP_CONFIG=
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD_FILE=
# RESTORE_TARGET_URI=
# RESTORE_ROOT=
