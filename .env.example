NODE_ENV=development
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/nestly
# Required in production: at least 32 random characters
SESSION_SECRET=
# Persistent disk directory; never expose this as a static public directory
UPLOAD_DIR=./uploads

# Optional private persistent document directory; default is UPLOAD_DIR/private-authorization
# AUTHORIZATION_DIR=

# Optional monthly rent plausibility bounds in INR (defaults shown)
# MIN_MONTHLY_RENT=2000
# MAX_MONTHLY_RENT=100000

# Render demo requires NODE_ENV=production, MONGO_URL, and SESSION_SECRET.
# These optional settings enable email delivery and administrator MFA.
APP_ORIGIN=
APP_DOMAIN=
MFA_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=
# Compose supplies separate durable volume paths.
STORAGE_DURABLE=false

# Operator-only backup/restore settings (not needed by the web app):
# BACKUP_CONFIRM=
# BACKUP_DIRECTORY=
# MONGO_BACKUP_CONFIG=
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD_FILE=
# RESTORE_TARGET_URI=
# RESTORE_ROOT=
