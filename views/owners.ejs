<%- include('partials/header') %><section><a href="/admin">← PG review queue</a><span class="eyebrow">OWNER MANAGEMENT</span><h1>PG owner accounts</h1><p>Review ownership evidence and restrict misleading accounts. Suspending an owner blocks sign-in and hides their public PGs until restored.</p><div class="actions"><a class="outline small" href="/admin/owners">All owners</a><a class="outline small" href="/admin/owners?state=suspended">Suspended owners</a></div><% for(const owner of owners){ %><article class="panel"><div class="section-heading"><div><h2><%= owner.name %></h2><p><%= owner.email %> · <%= owner.listingCount %> PG records</p></div><span class="badge"><%= owner.suspended?'Suspended':'Active' %></span></div><% if(owner.suspensionReason){ %><p>Last account decision: <%= owner.suspensionReason %></p><% } %><div class="two-cols"><form method="post" action="/admin/owners/<%= owner._id %>/state"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= owner.suspended?'restore':'suspend' %>"><label>Reason (required)<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button class="outline"><%= owner.suspended?'Restore owner account':'Suspend owner account' %></button></form><form method="post" action="/admin/owners/<%= owner._id %>/identity"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Owner evidence review<select name="status"><option value="unreviewed" <%= owner.identityStatus!=='reviewed'?'selected':'' %>>Not reviewed</option><option value="reviewed" <%= owner.identityStatus==='reviewed'?'selected':'' %>>Evidence reviewed</option></select></label><label>Evidence notes<textarea name="notes" required minlength="20" maxlength="1500"><%= owner.identityNotes||'' %></textarea></label><button class="outline">Record owner review</button><p class="muted">This internal evidence review does not imply physical property inspection.</p></form></div></article><% } if(!owners.length){ %><div class="empty">No matching owner accounts.</div><% } %><%- include('partials/pagination',{page,pages,base:q.state==='suspended'?'/admin/owners?state=suspended':'/admin/owners?'}) %></section><%- include('partials/footer') %>