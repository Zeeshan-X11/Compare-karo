<%- include('partials/header') %><section><span class="eyebrow">ADMINISTRATION</span><h1>Audit log</h1><p>Application events record actors and decisions. Database administrators retain separate infrastructure privileges; this is not a tamper-proof external archive.</p><div class="table-scroll"><table class="data-table"><thead><tr><th>Time</th><th>Action</th><th>Actor</th><th>Entity</th><th>Details</th></tr></thead><tbody><% for(const event of events){ %><tr><td><%= new Date(event.at).toISOString() %></td><td><%= event.action %></td><td><%= event.actorId||'Unauthenticated token holder' %></td><td><%= event.entityType %> <%= event.entityId %></td><td><%= JSON.stringify(event.details||{}) %></td></tr><% } %></tbody></table></div><%- include('partials/pagination',{page,pages,base:'/admin/audit?'}) %></section><%- include('partials/footer') %>
