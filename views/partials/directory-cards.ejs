<% const standalone = typeof inSharedGrid === 'undefined' || !inSharedGrid; %>
<% if(standalone){ %><div class="directory-grid directory-listings"><% } %>
  <% for(const entry of entries){ %>
  <article class="directory-card directory-listing-card">
    <div class="directory-photo">
      <div class="directory-photo-placeholder" <%= entry.sourcePhoto ? 'hidden' : '' %>>
        <%- include('icon', { name: 'building' }) %><span>Photo unavailable</span>
      </div>
      <% if(entry.sourcePhoto){ %>
        <a href="<%= entry.photoCreditUrl || entry.sourceUrl %>" target="_blank" rel="noopener noreferrer" aria-label="View photo source for <%= entry.name %>">
          <img src="<%= entry.sourcePhoto %>" alt="Listing photo for <%= entry.name %>" width="600" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        </a>
      <% } %>
      <% if(entry.advertisedRent != null){ %>
        <span class="directory-price"><%= money(entry.advertisedRent) %><small> / mo*</small></span>
      <% } %>
    </div>
    <div class="directory-card-body">
      <div class="directory-card-meta">
        <span class="directory-category"><%= entry.category %></span>
        <span class="directory-status">Public directory · Unverified</span>
      </div>
      <h3><%= entry.name %></h3>
      <p class="directory-address"><%- include('icon', { name: 'pin' }) %><span title="<%= entry.address %>"><%= entry.address %></span></p>
      <% if(entry.sourcePhone){ %>
        <p class="directory-contact"><a href="tel:<%= entry.sourcePhone %>"><%= entry.sourcePhone %></a><% if(entry.operatorContactUrl){ %><small>Operator</small><% } %></p>
      <% } %>
      <details class="directory-card-details">
        <summary>Listing info</summary>
        <p><%= entry.address %></p>
        <% if(entry.nearbyArea){ %><p>Nearby · <%= entry.nearbyArea %></p><% } %>
        <% if(entry.advertisedRent != null){ %><p>* Advertised starting rent. Not a confirmed quote.</p><% } %>
        <% if(entry.sourceSharing?.length){ %><p>Sharing: <%= entry.sourceSharing.join(', ') %></p><% } %>
        <% if(entry.sourceAmenities?.length){ %><p>Facilities: <%= entry.sourceAmenities.join(' · ') %></p><% } %>
        <% if(entry.sourceNote){ %><p><%= entry.sourceNote %></p><% } %>
        <% if(entry.operatorContactUrl){ %><p><a href="<%= entry.operatorContactUrl %>" target="_blank" rel="noopener noreferrer">Shared operator number ↗</a></p><% } %>
        <p>Source: <%= entry.sourceName %> · Checked <%= date(entry.checkedAt) %></p>
        <p>Confirm current rent and vacancies before visiting.</p>
      </details>
    <div class="directory-actions">
      <a class="button small" href="<%= entry.sourceUrl %>" target="_blank" rel="noopener noreferrer" aria-label="View source for <%= entry.name %>">View listing ↗</a>
      <a class="outline small" href="<%= entry.mapSearchUrl %>" target="_blank" rel="noopener noreferrer" aria-label="<%= entry.hasSourceMap ? 'Open location on Google Maps for ' : 'Search Google Maps for ' %><%= entry.name %>">Maps ↗</a>
      <% if(user){ const isSaved = directoryFavoriteIds.has(String(entry._id)); %>
        <form method="post" action="/favorites/directory/<%= entry._id %>" <% if(directorySaveReturn !== '/favorites'){ %>data-save-pg="<%= entry.name %>"<% } %>>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="<%= isSaved ? 'remove' : 'add' %>">
          <input type="hidden" name="returnTo" value="<%= directorySaveReturn %>">
          <button class="outline small directory-save" type="submit" data-saved="<%= isSaved %>" aria-label="<%= isSaved ? 'Remove ' + entry.name + ' from saved PGs' : 'Save ' + entry.name %>">
            <%- include('icon', { name: 'heart' }) %>
            <span data-save-label><%= isSaved ? 'Saved' : 'Save PG' %></span>
          </button>
        </form>
      <% }else{ %>
        <a class="outline small directory-save" href="/login"><%- include('icon', { name: 'heart' }) %> <span class="sr-only">Log in to save</span></a>
      <% } %>
    </div>
  </article>
  <% } %>
<% if(standalone){ %></div><% } %>
