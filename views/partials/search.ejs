<form class="search-bar" action="/listings" method="get"><label>OUR SERVICE AREA<select name="area"><% for(const area of localities){ %><option <%= q.area===area?'selected':'' %>><%= area %></option><% } %></select></label><label>MIN RENT / MONTH<input name="minRent" type="number" min="0" max="9999999" placeholder="No minimum" value="<%= typeof q.minRent==='string'?q.minRent:'' %>"></label><label>MAX RENT / MONTH<input name="maxRent" type="number" min="0" max="9999999" placeholder="No maximum" value="<%= typeof q.maxRent==='string'?q.maxRent:'' %>"></label><label>SHARING<select name="sharing"><option value="">Any sharing</option><% for(const s of sharing){ %><option <%= q.sharing===s?'selected':'' %>><%= s %></option><% } %></select></label><label>PG FOR<select name="category"><option value="">Everyone</option><% for(const c of ['Men','Women','Co-living']){ %><option <%= q.category===c?'selected':'' %>><%= c %></option><% } %></select></label><button class="button">Search PGs ↗</button></form>