<% if(!inquiries.length){ %><p class="muted">No inquiries yet.</p><% }for(const i of inquiries){ %><article class="inquiry"><h3><%= i.propertyName||i.propertyId?.publicSnapshot?.name||(['owner','admin'].includes(user.role)?i.propertyId?.name:null)||'Property no longer available' %></h3><span class="badge"><%= i.status==='visit_scheduled'?'Visit scheduled':i.status %></span><p class="preserve"><%= i.message %></p><p>Visit preference: <%= date(i.preferredVisitDate) %> · Sent <%= date(i.createdAt) %></p><% if(i.reply){ %><div class="notice"><strong>Owner response</strong><p class="preserve"><%= i.reply %></p></div><% }if(i.scheduledVisitAt){ %><p><strong>Scheduled visit:</strong> <%= new Date(i.scheduledVisitAt).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST</p><% }if(i.statusUpdatedAt){ %><small>Status updated: <%= date(i.statusUpdatedAt) %></small><% }if(['owner','admin'].includes(user.role)&&i.userId&&i.userId.email){ %><p>From <%= i.userId.name %> · <a href="mailto:<%= i.userId.email %>"><%= i.userId.email %></a></p><form method="post" action="/inquiries/<%= i._id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="two-cols"><label>Status<select name="status"><% for(const status of ['new','contacted','visit_scheduled','closed']){ %><option value="<%= status %>" <%= i.status===status?'selected':'' %>><%= status==='visit_scheduled'?'Visit scheduled':status %></option><% } %></select></label><label>Scheduled visit in IST (required when scheduling)<input type="datetime-local" name="scheduledVisitAt" value="<%= market.localVisit(i.scheduledVisitAt) %>"></label></div><label>Reply to the student (stored in Nestly)<textarea name="reply" maxlength="2000" placeholder="Answer questions or confirm the visit details..."></textarea></label><button class="outline small">Update inquiry</button></form><% } if((i.history||[]).length){ %><details><summary>Inquiry status history</summary><% for(const event of i.history){ %><p><%= date(event.at) %> · <%= event.status %><% if(event.reply){ %><br><%= event.reply %><% } %></p><% } %></details><% } %></article><% } %>