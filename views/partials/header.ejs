<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title.replace(/Nestly/g, 'PG Dekho') %> · Find your PG. Feel at home.</title><meta name="description" content="Find PG accommodation in <%= localities.join(", ") %>, Bengaluru. Compare details and connect with property owners."><meta name="theme-color" content="#2563eb"><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/professional.css"><link rel="stylesheet" href="/inner.css"><script src="/property-wizard.js" defer></script><script src="/app.js" defer></script></head>
<body><a class="skip" href="#main">Skip to content</a>
<header class="nav">
  <a class="brand" href="<%= user?.role==='admin'?'/admin':user?.role==='owner'?'/owner':'/' %>" aria-label="PG Dekho home">
    <img class="brand-logo" src="/pg-dekho-logo.png" width="1675" height="495" alt="PG Dekho">
  </a>
  <button class="nav-toggle" aria-expanded="false" aria-controls="navigation"><%- include('icon',{name:'menu'}) %><span>Menu</span></button>
  <nav id="navigation" aria-label="Main navigation">
    <% if(user?.role==='owner'){ %>
    <a class="nav-link" data-nav href="/owner">My properties</a>
    <a class="nav-link" data-nav href="/owner?tab=inquiries">Inquiry inbox</a>
    <a class="button small" href="/owner/new">+ Add PG</a>
    <% }else if(user?.role==='admin'){ %>
    <a class="nav-link" data-nav href="/admin">Review queue</a>
    <a class="nav-link" data-nav href="/admin/owners">Owners</a>
    <a class="nav-link" data-nav href="/admin?view=all">Properties & reports</a>
    <a class="nav-link" data-nav href="/admin/audit">Audit log</a>
    <% }else{ %>
    <a class="nav-link" data-nav href="/listings">Explore PGs</a>
    <% for(const locality of localities){ %><a class="nav-link" data-nav href="/listings?area=<%= encodeURIComponent(locality) %>"><%= locality %></a><% } %>
    <% if(!user){ %><a class="outline small nav-property" href="/list-property">List your property <span aria-hidden="true">↗</span></a><% } %>
    <% } %>
    <% if(user){ const roleName=user.role==='user'?'Student / seeker':user.role==='owner'?'PG owner':'Admin'; %>
      <details class="profile"><summary><span class="profile-avatar" aria-hidden="true"><%= user.name?.trim().charAt(0).toUpperCase()||'N' %></span><span class="profile-meta"><span><%= user.name %></span><small><%= roleName %></small></span><span class="profile-chevron" aria-hidden="true">⌄</span></summary>
        <div><span class="account-role"><%= roleName %></span><a href="/account">My profile</a><% if(user.role!=='user'){ %><a href="/account/security">Account security</a><% } %>
        <% if(user.role==='user'){ %><a href="/favorites">Saved PGs</a><a href="/compare">Compare PGs</a><a href="/inquiries">My inquiries</a><a href="/reports">My reports</a>
        <% }else if(user.role==='owner'){ %><a href="/owner">My properties</a><a href="/owner?tab=inquiries">Inquiry inbox</a><a href="/listings">Browse public website</a>
        <% }else if(user.role==='admin'){ %><a href="/admin">Admin review</a><a href="/admin/owners">Owner management</a><a href="/admin/directory">Public directory</a><a href="/listings">Preview public listings</a><a href="/owner">My own properties</a><% } %>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Log out</button></form></div>
      </details>
    <% }else{ %><a class="nav-link" data-nav href="/login">Log in</a><a href="/signup" class="button small">Sign up</a><% } %>
  </nav>
</header><main id="main">
