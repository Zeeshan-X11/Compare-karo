<% if(listing._id){ %><details class="panel saved-material"><summary>Publication & privacy settings</summary><div class="saved-material-body"><% if((listing.publicSnapshot?.publicationPolicyVersion||listing.publicationPolicyVersion)!==2 && listing.listingStatus==='published'){ %><div class="notice">This legacy listing requires a review against current requirements before it can appear publicly. Your saved data and files are retained. Complete the form and submit for review.</div><% } %><p>Withdraw contact, WhatsApp and exact-location permission immediately, including from the approved version.</p><form method="post" action="/owner/<%= listing._id %>/consent"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm" value="withdraw"><button class="outline">Withdraw publication permissions</button></form><form method="post" action="/owner/<%= listing._id %>/withdraw"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Reason to unpublish<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label><p>This removes the approved listing from public search immediately and records your request for admin review. Publication requires a new approval.</p><button class="outline">Request unpublish and hide now</button></form></div></details><% if(hasLive(listing)){const approved=listing.publicSnapshot||listing; %><details class="panel saved-material"><summary>Update current availability</summary><div class="saved-material-body"><p>Only availability changes here. Prices, approved room totals and all other pending edits still require admin review.</p><form method="post" action="/owner/<%= listing._id %>/availability"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Availability<select name="availabilityStatus"><% for(const status of ['unknown','available','unavailable']){ %><option <%= approved.availabilityStatus===status?'selected':'' %>><%= status %></option><% } %></select></label><% for(const room of approved.roomOptions||[]){ %><label><%= room.sharing %> rooms available (approved total: <%= room.totalRooms??'unconfirmed' %>)<input type="number" name="available<%= room.sharing %>" min="0" max="<%= room.totalRooms??0 %>" value="<%= room.availableRooms??'' %>"></label><% } %><button class="button">Confirm availability now</button></form></div></details><% }} %>
