<% if(!listings.length){ %><div class="empty"><span class="empty-icon">⌂</span><h3>A little space for something good.</h3><p>We're onboarding trusted local PGs. Check back soon.</p><% if(!user||user.role!=='user'){ %><p>Have a property in Yelahanka or Rajajinagar?</p><% } %><% if(!user||user.role!=='user'){ %><a href="/list-property" class="outline">List your PG ↗</a><% } %></div><% }else{ %><div class="cards"><% for(const l of listings){const photo=coverPhoto(l); %><article class="property-card"><a href="/listings/<%= l._id %>" class="photo"><% if(photo){ %><img loading="lazy" width="800" height="600" decoding="async" src="/media/<%= (photo.thumbnail||photo.filename) %>" alt="<%= photo.type %> at <%= l.name %>"><% }else{ %><span>⌂<small>Photos coming soon</small></span><% } %></a><div class="card-body"><span class="eyebrow"><%= l.locality %> · <%= l.propertyCategory %></span><h3><a href="/listings/<%= l._id %>"><%= l.name %></a></h3><p><%= l.address %></p><div class="chips"><% for(const s of l.sharingOptions||[]){ %><span><%= s %> sharing</span><% } %><% if((l.amenities||[]).includes('Wi-Fi')){ %><span>Wi-Fi</span><% } if((l.foodOptions||[]).length){ %><span>Meals offered</span><% } %></div><strong><%= money(l.monthlyRent) %></strong><% if(l.monthlyRent!=null){ %><small> / month, starting rent</small><% } %><p class="muted">Ask owner about availability · Last confirmed: <%= date(l.availabilityConfirmedAt) %></p><% if(!user||user.role==='user'){ %><div class="card-tools"><% if(user){ %><form method="post" action="/favorites/<%= l._id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= favoriteIds.has(String(l._id))?'remove':'add' %>"><input type="hidden" name="returnTo" value="/listings"><button class="outline small"><%= favoriteIds.has(String(l._id))?'♥ Saved':'♡ Save' %></button></form><% } %><form method="post" action="/compare/<%= l._id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= compareIds.has(String(l._id))?'remove':'add' %>"><button class="outline small"><%= compareIds.has(String(l._id))?'Remove comparison':'Compare +' %></button></form></div><% } %><a class="detail-link" href="/listings/<%= l._id %>">View details ↗</a></div></article><% } %></div><% } %>