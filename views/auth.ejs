<%- include('partials/header') %>
<section class="auth-wrap">
  <div class="auth-intro"><span class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</span><h1><%= signup?'Make yourself at home.':'Welcome home.' %></h1><p>Find your space. Meet your neighbourhood. Start something new.</p><div class="auth-graphic" aria-hidden="true">⌂</div></div>
  <form method="post" action="/<%= signup?'signup':'login' %>" class="panel">
    <h2><%= signup?'Create an account':'Log in to Nestly' %></h2>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="flow" value="<%= signup?'signup':'login' %>">
    <% if(q.googleCancelled==='1'){ %><p class="notice" role="status">Google sign-in was cancelled. You can try again or use your email and password.</p><% } %>
    <% if(signup){ %><label>I'm here to<select name="role"><option value="user">Find a PG</option><option value="owner" <%= q.role==='owner'?'selected':'' %>>List and manage my PG</option></select></label><% } %>
    <button class="google-signin" type="submit" formaction="/auth/google" formnovalidate <%= googleReady?'':'disabled' %> aria-describedby="google-help">Continue with Google</button>
    <p id="google-help" class="muted auth-help"><%= googleReady?(signup?'Your selection above applies to a new Google account. Existing accounts keep their current role.':'New Google accounts start as students. To register as a PG owner, choose Create an account.'):'Google sign-in is not configured yet. Please use email and password below.' %></p>
    <div class="auth-divider"><span>or use email</span></div>
    <% if(signup){ %><label>Your name<input name="name" required maxlength="80" autocomplete="name"></label><% } %>
    <label>Email address<input type="email" name="email" required maxlength="254" autocomplete="email"></label>
    <label>Password<input type="password" name="password" required minlength="12" maxlength="128" autocomplete="<%= signup?'new-password':'current-password' %>"></label>
    <% if(signup){ %><small>Use at least 12 characters.</small><p class="muted">By creating an account, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy policy</a>.</p><% } %>
    <button class="button" type="submit"><%= signup?'Create account →':'Log in →' %></button>
    <p><%= signup?'Already have an account?':'New to Nestly?' %> <a href="/<%= signup?'login':'signup' %>"><%= signup?'Log in':'Create an account' %></a></p>
    <% if(!signup){ %><p><a class="quiet" href="/forgot-password">Forgot your password?</a></p><% } %>
  </form>
</section>
<%- include('partials/footer') %>
