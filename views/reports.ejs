<%- include('partials/header') %><section><span class="eyebrow">YOUR REPORTS</span><h1>Listing report status</h1><% if(!reports.length){ %><p>You have not reported a listing.</p><% } for(const item of reports){const r=item.reports; %><article class="panel"><h2><%= r.propertyName||'Reported property' %></h2><p><%= r.message %></p><p>Status: <strong><%= r.status||'open' %></strong> · Reported <%= date(r.createdAt) %></p><% if(r.resolution){ %><p>Admin response: <%= r.resolution %></p><p>Reviewed <%= date(r.reviewedAt) %></p><% } %></article><% } %><%- include('partials/pagination',{page,pages,base:'/reports?'}) %></section><%- include('partials/footer') %>
