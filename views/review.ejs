<%- include('partials/header') %>
<section class="portal-page admin-review-page">
  <a class="back" href="/admin">← Review queue</a>
  <header class="section-heading portal-header"><div><span class="eyebrow">PROPERTY REVIEW</span><h1><%= listing.name||'Untitled draft' %></h1><span class="badge"><%= publicationState(listing) %></span></div><% if(hasLive(listing)){ %><a class="button" href="/listings/<%= listing._id %>" target="_blank" rel="noopener">View public listing ↗</a><% } %></header>
  <% if(reviewError){ %><div class="notice review-error" role="alert"><strong>The action could not be completed.</strong><p><%= reviewError %></p><p>Your listing has not been approved by this attempt. Review the checklist below.</p></div><% } %>
  <section class="panel review-readiness" id="approval-checklist" aria-labelledby="approval-title">
    <h2 id="approval-title"><%= readiness.blockers.length?'Approval needs attention':listing.listingStatus==='published'?'Publication complete':'Ready for admin review' %></h2>
    <% if(readiness.blockers.length){ %><ul><% for(const issue of readiness.blockers){ %><li><%= issue %></li><% } %></ul><% }else if(listing.listingStatus!=='published'){ %><p>The required property details and security scans are complete. Open the supporting documents, review the photos, then confirm your decision below.</p><% }else{ %><p><%= hasLive(listing)?'This PG is visible to students.':'This listing is not currently public. Check owner suspension, withdrawal or legacy review requirements.' %></p><% } %>
    <% if(listing.listingStatus==='draft'){ %><p><strong>Saved draft — not submitted for approval.</strong> The owner must complete the listing and submit it.</p><% } %>
    <% if(readiness.unscanned && !readiness.scannerConfigured){ %><p class="review-operator-note"><strong>Site operator setup:</strong> Configure the private ClamAV service using <code>CLAMD_HOST</code> and <code>CLAMD_PORT</code>, restart the app, then run the document scan here. The existing files are saved; the owner does not need to upload them again.</p><% } %>
    <nav class="actions" aria-label="Review steps"><a class="outline small" href="#authorization-review">1. Scan & review documents</a><a class="outline small" href="#photo-review">2. Review photos</a><a class="outline small" href="#moderation-decision">3. Make a decision</a></nav>
  </section>
  <% if(hasLive(listing)&&listing.listingStatus!=='published'){ %><div class="notice">This is a pending revision. The previous approved version remains publicly visible; approval replaces it, while rejection or correction requests leave it intact.</div><details class="panel"><summary>Current public version and its evidence</summary><p><strong><%= listing.publicSnapshot.name %></strong><br><%= listing.publicSnapshot.address %><br>Starting rent: <%= money(listing.publicSnapshot.monthlyRent) %></p><% for(const document of listing.approvedAuthorizationDocuments||[]){ %><p><%= document.documentType %> — approved-version evidence · Scan: <%= document.scanStatus||'quarantined' %><% if(document.scanStatus==='clean'){ %> · <a href="/listings/<%= listing._id %>/authorization/<%= document._id %>" target="_blank" rel="noopener">Open evidence ↗</a><% } %></p><% if(document.scanStatus!=='clean'){ %><form method="post" action="/admin/<%= listing._id %>/authorization/<%= document._id %>/scan"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="outline small" <%= readiness.scannerConfigured?'':'disabled' %>>Run security scan</button></form><% } %><% } %></details><% } %>
  <details class="panel" open><summary>Submitted property information</summary><dl class="review-facts"><% for(const [key,label] of [['description','Description'],['locality','Locality'],['address','Exact address'],['monthlyRent','Starting rent'],['securityDeposit','Deposit'],['oneTimeFee','One-time fee'],['propertyCategory','Category'],['sharingOptions','Sharing'],['amenities','Amenities'],['foodOptions','Meals'],['foodIncluded','Meals included'],['houseRules','House rules'],['contactName','Contact name'],['contactPhone','Contact phone'],['contactPublic','Contact publication permission'],['whatsappAllowed','WhatsApp permission'],['ownerAuthorized','Owner publication authorization'],['sourceUrl','Source URL'],['sourceDate','Source date'],['availabilityStatus','Availability'],['availabilityConfirmedAt','Availability confirmed'],['priceConfirmedAt','Price confirmed']]){ %><dt><%= label %></dt><dd><%= listing[key]==null?'Unknown':String(listing[key]) %></dd><% } %></dl><p>Account: <%= listing.ownerId?listing.ownerId.name+' · '+listing.ownerId.email:'Missing owner' %></p><h3>Sharing-wise rent and vacancies</h3><div class="table-scroll"><table class="data-table"><thead><tr><th scope="col">Sharing</th><th scope="col">Rent</th><th scope="col">Total rooms</th><th scope="col">Available rooms</th></tr></thead><tbody><% for(const room of listing.roomOptions||[]){ %><tr><td><%= room.sharing %></td><td><%= money(room.monthlyRent) %></td><td><%= room.totalRooms==null?'Unknown':room.totalRooms %></td><td><%= room.availableRooms==null?'Unknown':room.availableRooms %></td></tr><% } %></tbody></table></div><h3>Proposed property location</h3><% if(proposedLocationUrl){ %><p><a class="quiet" href="<%= proposedLocationUrl %>" target="_blank" rel="noopener noreferrer">Check submitted location in Google Maps ↗</a></p><% }else{ %><p>No exact location submitted.</p><% } %><p>Owner publication permission: <%= listing.coordinates?.publicationAuthorized ? "Yes" : "No" %></p></details>
  <section class="panel" id="authorization-review" aria-labelledby="authorization-title"><h2 id="authorization-title">PG operation authorization — private review</h2><p>First run security scanning, then open each document. Check the property name/address, issuer, reference, validity and the owner's authority to operate this PG. A clean security scan does not prove government approval or authenticity.</p>
    <% if(!(listing.authorizationDocuments||[]).length){ %><div class="notice">No authorization document supplied. Ask the owner to upload supporting documents and resubmit. Approval is blocked.</div><% } %>
    <% for(const document of listing.authorizationDocuments||[]){ %><article class="authorization-record"><h3><%= document.documentType %></h3><p>Issuer: <%= document.issuingAuthority||'Not supplied' %><br>Reference: <%= document.reference||'Not supplied' %><br>Uploaded: <%= date(document.uploadedAt) %> · Declaration: <%= document.declaration?'Provided':'Missing' %><br>Security scan: <strong><%= document.scanStatus==='clean'?'Passed':document.scanStatus==='infected'?'Threat detected — blocked':'Waiting for security scan' %></strong><br>Human review: <%= document.status %></p>
      <% if(document.scanStatus==='clean'){ %><a class="outline" target="_blank" rel="noopener" href="/listings/<%= listing._id %>/authorization/<%= document._id %>"><%= document.mimeType==='application/pdf'?'Download authorization PDF':'Open document scan' %></a><% if(document.mimeType!=='application/pdf'){ %><img class="authorization-preview" loading="lazy" src="/listings/<%= listing._id %>/authorization/<%= document._id %>" alt="Private <%= document.documentType %> scan"><% } %>
      <% }else{ %><div class="notice"><%= document.scanStatus==='infected'?'This document cannot be opened. Ask the owner for a safe replacement.':'The document is saved privately and cannot be opened until security scanning passes.' %></div><form method="post" action="/admin/<%= listing._id %>/authorization/<%= document._id %>/scan"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="outline" <%= readiness.scannerConfigured?'':'disabled' %>>Run security scan</button><% if(!readiness.scannerConfigured){ %><p class="muted">Waiting for the site operator to configure the scanner.</p><% } %></form><% } %>
      <% if(document.reviewedAt){ %><p>Last reviewed <%= date(document.reviewedAt) %></p><% } %>
    </article><% } %><p class="muted">These documents are never displayed on public property pages or cards.</p>
  </section>
  <section class="panel" id="photo-review" aria-labelledby="photos-title"><h2 id="photos-title">Photo permissions review</h2><p>Review the photos and obtain original evidence from the owner if authenticity or rights are unclear.</p><div class="gallery"><% for(const img of listing.images){ %><figure><a href="/media/<%= img.filename %>"><img loading="lazy" src="/media/<%= img.filename %>" alt="<%= img.type %>"></a><figcaption><%= img.type %> · <%= img.status %><br>Rights declared: <%= img.rightsDeclared?'yes':'no' %><br>Uploaded <%= date(img.uploadedAt) %></figcaption></figure><% } %></div></section>
  <form method="post" action="/admin/<%= listing._id %>" class="panel" id="moderation-decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Moderation decision</h2><label>Moderation notes (required for rejection / corrections / unpublishing)<textarea name="notes" maxlength="2000"><%= decisionValues.notes??listing.moderationNotes??'' %></textarea></label><label class="check"><input type="checkbox" name="reviewed" value="yes" <%= decisionValues.reviewed?'checked':'' %>>I reviewed the property data, owner publication authorization, and every photo's authenticity and publication rights.</label><label class="check"><input type="checkbox" name="authorizationReviewed" value="yes" <%= decisionValues.authorizationReviewed?'checked':'' %>>I opened and reviewed the operation authorization documents and accept them as supporting evidence for this listing.</label><label class="check"><input type="checkbox" name="locationReviewed" value="yes" <%= decisionValues.locationReviewed?'checked':'' %>>I checked that the submitted location matches the PG and that the owner authorized its publication.</label><% if(readiness.blockers.length){ %><p class="notice">Approval is unavailable until the <a href="#approval-checklist">checklist above</a> is complete. You can still request corrections or reject with a reason.</p><% } %><div class="actions"><% if(listing.listingStatus==='submitted'){ %><button class="button" name="action" value="approve" <%= readiness.canApprove?'':'disabled' %> aria-describedby="approval-checklist">Approve & publish PG</button><% }if(listing.listingStatus==='approved'){ %><button class="button" name="action" value="publish" <%= readiness.canPublish?'':'disabled' %> aria-describedby="approval-checklist">Publish approved listing</button><% } %><button class="outline" name="action" value="corrections">Request corrections</button><button class="outline" name="action" value="reject">Reject with reason</button><button class="outline" name="action" value="unpublish">Unpublish / return to draft</button></div><p class="muted">Approval publishes the PG for student search. It is not an identity verification, physical inspection, or quality guarantee.</p></form>
  <details class="panel"><summary>Record an additional property check</summary><form method="post" action="/admin/<%= listing._id %>/verification"><input type="hidden" name="_csrf" value="<%= csrf %>"><p>Record only checks that actually happened. Document review and a site visit are different scopes and do not guarantee quality.</p><label>Check performed<select name="method"><% for(const [value,label] of [['unverified','No completed check'],['documents','Supporting documents reviewed'],['site-visit','Physical site visit recorded']]){ %><option value="<%= value %>" <%= listing.verification?.method===value?'selected':'' %>><%= label %></option><% } %></select></label><label>Actual check date<input type="date" name="performedAt" value="<%= listing.verification?.performedAt?new Date(listing.verification.performedAt).toISOString().slice(0,10):'' %>"></label><label>Evidence and scope notes<textarea name="notes" required minlength="20" maxlength="2000"><%= listing.verification?.notes||'' %></textarea></label><button class="outline">Record check</button></form></details>
  <details class="panel"><summary>Decision history & reports</summary><h2>Decision history</h2><% for(const entry of listing.moderationHistory||[]){ %><p><%= date(entry.at) %> · <%= entry.action %> · <%= entry.actorId %><br><%= entry.notes %></p><% } %><h2>Reports</h2><% if(!listing.reports.length){ %><p>No reports.</p><% } for(const r of listing.reports){ %><article class="inquiry"><p><%= date(r.createdAt) %> · <%= r.message %></p><span class="badge"><%= r.status||'open' %></span><% if(r.resolution){ %><p><%= r.resolution %> · Reviewed <%= date(r.reviewedAt) %></p><% } %><form method="post" action="/admin/<%= listing._id %>/reports/<%= r._id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Outcome<select name="status"><option value="resolved">Resolved</option><option value="dismissed">Dismissed</option></select></label><label>Reason / action taken<textarea name="resolution" required minlength="10" maxlength="1500"></textarea></label><button class="outline small">Record report decision</button></form></article><% } %><% if(listing.withdrawalRequest?.requestedAt){ %><p>Owner requested unpublish (<%= listing.withdrawalRequest.reviewedAt?'review recorded':'awaiting admin review' %>): <%= date(listing.withdrawalRequest.requestedAt) %> — <%= listing.withdrawalRequest.reason %></p><% } %></details>
</section>
<%- include('partials/footer') %>
