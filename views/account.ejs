<%- include('partials/header') %><section class="prose"><span class="eyebrow">MY ACCOUNT</span><h1>Your Nestly account</h1><p><a class="quiet" href="/account/security">Email verification and account security →</a><% if(user.role==='user'){ %> · <a href="/reports">My listing reports →</a><% } %></p><div class="panel"><h2><%= user.name %></h2><p><%= user.email %></p><p>Account type: <strong><%= user.role==='user'?'Student / seeker':user.role==='owner'?'PG owner':'Administrator' %></strong></p><% if(q.changed==='1'){ %><div class="notice" role="status">Your account is now a student / seeker account. Owner tools are disabled.</div><% } if(user.role==='user'){ %><p>Your account stays a student account when you browse or contact PG owners. It cannot create properties or access owner/admin dashboards.</p><a class="button" href="/listings">Find a PG →</a><% } if(user.role==='owner'&&!hasListings){ %><h3>Did you intend to register as a student?</h3><p>If this account became an owner through the earlier onboarding flow, you can explicitly correct it here. This option is available only while you have no PG listings.</p><form method="post" action="/account/student"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="check"><input type="checkbox" name="confirm" value="student" required>I want to use this account only as a student / seeker.</label><button class="outline">Use a student account</button></form><% } %></div></section><%- include('partials/footer') %>
