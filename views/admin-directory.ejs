<%- include('partials/header') %>
<section class="portal-page admin-portal">
  <div class="workspace-bar"><span><%- include('partials/icon',{name:'grid'}) %> Admin workspace</span><nav aria-label="Admin workspace"><a href="/admin">Property reviews</a><a href="/admin/owners">Manage owners</a><a href="/admin/directory" aria-current="page">Public directory</a><a href="/admin/audit">Audit log</a></nav></div>
  <header class="section-heading portal-header"><div><span class="eyebrow portal-kicker">PUBLIC SOURCE DIRECTORY</span><h1>Directory management</h1><p class="portal-subtitle">Unverified public leads, separate from owner submissions. Hiding an entry removes it immediately from the directory.</p></div><a class="outline" href="/directory/rajanukunte">Public preview ↗</a></header>
  <div class="directory-admin-grid"><% for(const entry of entries){ %><article class="panel"><h2><%= entry.name %></h2><p><%= entry.address %> · <strong><%= entry.hidden?'Hidden':'Visible · Unverified' %></strong></p><p><a href="<%= entry.sourceUrl %>" target="_blank" rel="noopener noreferrer"><%= entry.sourceName %> ↗</a> · Source checked <%= date(entry.checkedAt) %></p><% if(entry.moderationReason){ %><p>Last reason: <%= entry.moderationReason %></p><% } %><form method="post" action="/admin/directory/<%= entry.slug %>/visibility"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= entry.hidden?'show':'hide' %>"><label>Reason for this change<input name="reason" minlength="10" maxlength="500" required></label><button class="outline"><%= entry.hidden?'Restore directory entry':'Hide directory entry' %></button></form></article><% } %></div>
  <% if(!entries.length){ %><p class="notice">No public directory entries have been imported.</p><% } %>
  <% if(pages>1){ %><nav class="pagination" aria-label="Directory management pages"><% if(page>1){ %><a href="?page=<%= page-1 %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if(page<pages){ %><a href="?page=<%= page+1 %>">Next →</a><% } %></nav><% } %>
</section>
<%- include('partials/footer') %>
