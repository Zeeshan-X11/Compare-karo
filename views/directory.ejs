<%- include('partials/header') %>
<section class="student-page directory-page">
  <%- include('partials/student-nav',{active:'explore'}) %>
  <nav class="property-breadcrumb" aria-label="Breadcrumb"><a href="/listings">Explore PGs</a><span aria-hidden="true">/</span><span aria-current="page">Rajanukunte directory</span></nav>
  <header class="student-heading"><div><span class="student-kicker">RAJANUKUNTE & NEARBY · BENGALURU</span><h1>A local start to your PG search.</h1><p>Discover publicly listed PGs around Rajanukunte and Presidency University.</p></div><a class="outline" href="/listings?area=Rajanukunte">Owner-listed PGs ↗</a></header>
  <div class="directory-intro">
    <div class="panel directory-explanation"><span class="eyebrow">PUBLIC DIRECTORY</span><h2>More places to explore.</h2><p>These entries are visible without Nestly approval. They come from linked public sources and have not been verified by Nestly.</p><p>This is a growing directory, not a complete list or a live vacancy feed. Confirm that a PG is operating, visit it and check current rent before making a decision.</p><p class="muted">The map shows the locality. “Find on Maps” searches by property name and address; its results are not reviewed property pins.</p></div>
    <div class="panel directory-map"><%- include('partials/map',{map}) %></div>
  </div>
  <div class="results-toolbar directory-toolbar"><div><h2><%= total %> <%= total===1?'directory entry':'directory entries' %></h2><p>Includes nearby Dibbur and Shanubhoganahalli where marked.</p></div><form action="/directory/rajanukunte" method="get" class="directory-filter"><label for="directory-category">PG category</label><select id="directory-category" name="category"><option value="">All categories</option><% for(const c of ['Men','Women','Co-living']){ %><option <%= category===c?'selected':'' %>><%= c %></option><% } %></select><button class="outline small">Apply</button></form></div>
  <% if(entries.length){ %><%- include('partials/directory-cards',{entries}) %><% }else{ %><div class="student-empty"><h2>No directory entries on this page.</h2><p>Try another category or return to the first page.</p><a class="button" href="/directory/rajanukunte">View all directory entries</a></div><% } %>
  <% if(pages>1){ %><nav class="pagination" aria-label="Directory pages"><% if(page>1){ %><a class="outline" href="?category=<%= encodeURIComponent(category) %>&page=<%= page-1 %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if(page<pages){ %><a class="outline" href="?category=<%= encodeURIComponent(category) %>&page=<%= page+1 %>">Next →</a><% } %></nav><% } %>
</section>
<%- include('partials/footer') %>
