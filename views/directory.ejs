<%- include('partials/header') %>
<section class="student-page directory-page">
  <%- include('partials/student-nav',{active:'explore'}) %>
  <nav class="property-breadcrumb" aria-label="Breadcrumb"><a href="/listings">Explore PGs</a><span aria-hidden="true">/</span><span aria-current="page">Rajanukunte directory</span></nav>
  <header class="student-heading"><div><span class="student-kicker">RAJANUKUNTE · BENGALURU</span><h1>A local start to your PG search.</h1><p>Discover publicly listed PGs in Rajanukunte, Bengaluru.</p></div><a class="outline" href="/listings?area=Rajanukunte">Owner-listed PGs ↗</a></header>
  <div class="directory-intro">
    <div class="panel directory-explanation"><span class="eyebrow">PUBLIC DIRECTORY</span><h2>More places to explore.</h2><p>These entries come from linked public sources and have not been verified by PG Dekho. This is a growing directory, not a complete list or a live vacancy feed.</p><p class="muted">Each card links to the PG on Google Maps or searches by its name and listed address. Confirm the location and current rent before visiting.</p></div>
  </div>
  <div class="results-toolbar directory-toolbar"><div><h2><%= total %> <%= total===1?'directory entry':'directory entries' %></h2><p>Rajanukunte entries only. Other localities are excluded.</p></div><form action="/directory/rajanukunte" method="get" class="directory-filter"><label for="directory-search">Name or street</label><input id="directory-search" name="q" maxlength="80" value="<%= typeof term==='string'?term:'' %>" placeholder="Search a PG or road"><label for="directory-category">PG category</label><select id="directory-category" name="category"><option value="">All categories</option><% for(const c of ['Men','Women','Co-living']){ %><option <%= category===c?'selected':'' %>><%= c %></option><% } %></select><button class="outline small">Apply</button></form></div>
  <% if(entries.length){ %><%- include('partials/directory-cards',{entries,directorySaveReturn:'/directory/rajanukunte'}) %><% }else{ %><div class="student-empty"><h2>No directory entries on this page.</h2><p>Try another category or return to the first page.</p><a class="button" href="/directory/rajanukunte">View all directory entries</a></div><% } %>
  <% if(pages>1){ %><nav class="pagination" aria-label="Directory pages"><% if(page>1){ %><a class="outline" href="?category=<%= encodeURIComponent(category) %>&q=<%= encodeURIComponent(typeof term==='string'?term:'') %>&page=<%= page-1 %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if(page<pages){ %><a class="outline" href="?category=<%= encodeURIComponent(category) %>&q=<%= encodeURIComponent(typeof term==='string'?term:'') %>&page=<%= page+1 %>">Next →</a><% } %></nav><% } %>
<%- include('partials/local-guide') %></section>
<%- include('partials/footer') %>
