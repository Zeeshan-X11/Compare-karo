<%- include('partials/header') %><section class="prose"><div class="panel"><h1><%= purpose==='request'?'Reset your password':purpose==='reset'?'Choose a new password':'Confirm your email' %></h1><form method="post" action="<%= purpose==='request'?'/forgot-password':purpose==='reset'?'/reset-password':'/account/verify' %>" <%- purpose==='request'?'':'data-token-form' %>><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(purpose==='request'){ %><label>Registered and verified email<input name="email" type="email" autocomplete="email" required maxlength="254"></label><% }else{ %><input type="hidden" name="token" value=""><p data-token-status>Open the full link from your email to continue.</p><% } if(purpose==='reset'){ %><label>New password<input type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" required></label><% } %><button class="button"><%= purpose==='request'?'Request recovery instructions':purpose==='reset'?'Save new password':'Confirm email ownership' %></button></form></div></section><%- include('partials/footer') %>
